"""Appointment creation shared by POST /book-appointment (patients + Bolna agent)."""
from datetime import date

from fastapi import HTTPException

from database import appointments_collection, departments_collection, doctors_collection, patients_collection, invoices_collection
from services.common import now, short_id, parse_date
from services.notify import create_notification, email_patient, appt_params

ACTIVE_STATUSES = ["pending", "confirmed", "rescheduled", "scheduled"]


async def resolve_department(hospital_id: str, name_or_id: str) -> dict:
    q = {"hospital_id": hospital_id, "active": True, "$or": [{"department_id": name_or_id}, {"name": {"$regex": f"^{name_or_id.strip()}$", "$options": "i"}}]}
    return await departments_collection.find_one(q)


async def create_invoice(appt: dict, dept: dict, doctor: dict) -> dict:
    fee = float((doctor or {}).get("consultation_fee") or (dept or {}).get("consultation_fee") or 0)
    label = f"{appt['department']} consultation" + (f" — {doctor['name']}" if doctor else "")
    inv = {"invoice_id": short_id("INV-"), "hospital_id": appt["hospital_id"], "patient_id": appt["patient_id"],
           "patient_name": appt["patient_name"], "appointment_id": appt["appointment_id"],
           "items": [{"label": label, "amount": fee}], "total": fee, "currency": "INR",
           "status": "pending", "created_at": now(), "updated_at": now()}
    await invoices_collection.insert_one(inv)
    return inv


async def book(*, hospital_id: str, patient_name: str, department: str, preferred_date: str, preferred_time: str,
               doctor_id: str = None, patient_id: str = None, source: str = "web", notes: str = None, patient_email: str = None,
               conversation_id: str = None) -> dict:
    d = parse_date(preferred_date)
    if d is None:
        raise HTTPException(status_code=422, detail="preferred_date must be YYYY-MM-DD")
    if d < date.today():
        raise HTTPException(status_code=422, detail="Please choose today or a future date")

    dept = await resolve_department(hospital_id, department) if departments_collection is not None else None
    if departments_collection is not None and await departments_collection.count_documents({"hospital_id": hospital_id}) and not dept:
        raise HTTPException(status_code=422, detail="Unknown department")
    doctor = None
    if doctor_id:
        doctor = await doctors_collection.find_one({"hospital_id": hospital_id, "doctor_id": doctor_id})
        if not doctor:
            raise HTTPException(status_code=422, detail="Unknown doctor")
        if dept and doctor.get("department_id") != dept["department_id"]:
            raise HTTPException(status_code=422, detail="This doctor is not in the selected department")
        if not doctor.get("available", True):
            raise HTTPException(status_code=409, detail="This doctor is not taking appointments right now")
        clash = await appointments_collection.find_one({"hospital_id": hospital_id, "doctor_id": doctor_id,
                                                        "preferred_date": preferred_date, "preferred_time": preferred_time,
                                                        "status": {"$in": ACTIVE_STATUSES}})
        if clash:
            raise HTTPException(status_code=409, detail="This time slot is already booked for the doctor. Please choose another time.")

    patient = await patients_collection.find_one({"patient_id": patient_id}) if patient_id else None
    appt = {
        "appointment_id": short_id(), "hospital_id": hospital_id, "patient_id": patient_id,
        "patient_name": patient_name.strip(), "patient_email": (patient or {}).get("email") or patient_email, "patient_phone": (patient or {}).get("phone"),
        "department": dept["name"] if dept else department, "department_id": (dept or {}).get("department_id"),
        "doctor_id": doctor_id, "doctor_name": (doctor or {}).get("name"),
        "preferred_date": preferred_date, "preferred_time": preferred_time,
        "status": "pending", "source": source, "notes": notes, "history": [], "conversation_id": conversation_id,
        "created_at": now(), "updated_at": now(),
    }
    if appointments_collection is not None:
        await appointments_collection.insert_one(appt)
    invoice = await create_invoice(appt, dept, doctor) if (patient_id and invoices_collection is not None) else None
    if invoice:
        await appointments_collection.update_one({"appointment_id": appt["appointment_id"]}, {"$set": {"invoice_id": invoice["invoice_id"]}})
        appt["invoice_id"] = invoice["invoice_id"]

    params = appt_params(appt)
    await create_notification(hospital_id=hospital_id, audience="admin", ntype="new_appointment", params=params, link="/admin/appointments")
    if patient_id:
        await create_notification(hospital_id=hospital_id, audience="patient", patient_id=patient_id, ntype="appointment_booked",
                                  params=params, link="/account/appointments")
        await email_patient("appointment_booked", hospital_id=hospital_id, patient=patient, appointment=appt)
    elif patient_email:
        await email_patient("appointment_booked", hospital_id=hospital_id, patient_email=patient_email, appointment=appt)
    return appt
