# ==================== MONGODB ====================
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=clinova_hospital

# ==================== JWT & AUTHENTICATION ====================
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=30
PATIENT_TOKEN_EXPIRE_MINUTES=10080

# ==================== HOSPITAL ====================
DEFAULT_HOSPITAL_ID=DEFAULT
HOSPITAL_NAME=Default Hospital
HOSPITAL_TAGLINE=Hospital Management Platform
HOSPITAL_ADDRESS=123 Hospital Street
HOSPITAL_CITY=Bengaluru
HOSPITAL_PHONE=+91-9876543210
HOSPITAL_EMAIL=admin@hospital.com
HOSPITAL_EMERGENCY_PHONE=+91-9876543210
HOSPITAL_DAYS=Monday-Saturday
HOSPITAL_HOURS=09:00 AM - 09:00 PM
HOSPITAL_SUNDAY_HOURS=Closed
HOSPITAL_LATITUDE=13.0827
HOSPITAL_LONGITUDE=80.2707

# ==================== AI RECEPTIONIST (BOLNA) ====================
BOLNA_API_KEY=your_bolna_api_key_here
BOLNA_AGENT_ID=your_bolna_agent_id_here
BOLNA_API_BASE=https://api.bolna.ai
AI_RECEPTIONIST_PHONE=your_ai_receptionist_phone_here
AGENT_API_KEY=your_agent_api_key_here

# ==================== SPEECH-TO-TEXT (DEEPGRAM) ====================
STT_API_KEY=your_deepgram_api_key_here

# ==================== EMAIL ====================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here
EMAIL_FROM=noreply@hospital.com
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT_SECONDS=10

# ==================== PAYMENTS (RAZORPAY) ====================
# WARNING: Never expose RAZORPAY_KEY_SECRET to frontend
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_do_not_expose_to_frontend
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ==================== FRONTEND ====================
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_URL=http://localhost:5173

# ==================== SERVER ====================
SERVER_PORT=8000
DEBUG=false
